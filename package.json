{
	"name": "@parseapi/sdk",
	"version": "0.3.1",
	"description": "Official parseAPI client for Node and TypeScript. One key, minimal JSON, fast.",
	"keywords": [
		"parseapi",
		"ip",
		"geolocation",
		"email validation",
		"phone validation",
		"postal",
		"timezone",
		"currency",
		"weather"
	],
	"license": "MIT",
	"author": "parseAPI <hello@parseapi.com> (https://parseapi.com)",
	"homepage": "https://parseapi.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/parseapi/node.git"
	},
	"bugs": {
		"url": "https://github.com/parseapi/node/issues"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --target node18 --clean",
		"prepublishOnly": "npm test && npm run typecheck && npm run api:check",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"smoke": "npm run build && node smoke/smoke.mjs",
		"api:check": "npm run build && node scripts/check-api.mjs && node scripts/check-package.mjs",
		"api:update": "npm run build && node scripts/check-api.mjs --write"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsup": "^8.3.5",
		"typescript": "^5.7.0",
		"vitest": "^2.1.8"
	}
}
